#!/usr/bin/env bash

set -euo pipefail

cat <<'HELP'
Environment variables:
  ASDF_OPENBAO_HSM=1
    Install the HSM-enabled `bao` build (Linux amd64/arm64 only).
  ASDF_OPENBAO_SKIP_CHECKSUM=1
    Skip SHA256 checksum verification of the downloaded release archive.
  ASDF_OPENBAO_INCLUDE_PRERELEASES=1
    Include alpha/beta releases in `asdf list all openbao`.
  ASDF_OPENBAO_OVERWRITE_PLATFORM=<linux|darwin|freebsd|netbsd|openbsd|illumos|solaris|windows>
  ASDF_OPENBAO_OVERWRITE_ARCH=<amd64|arm64|armv6|ppc64le|riscv64|s390x>
    Override platform/architecture detection (useful for cross-installs).
  GITHUB_API_TOKEN
    GitHub token used when listing releases, to avoid API rate limiting.
HELP
